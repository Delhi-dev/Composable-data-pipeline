 # Python environments and generated bytecode
  .venv/
  venv/
  __pycache__/
  *.py[cod]
  *$py.class

  # Test, type-checking and coverage output
  .pytest_cache/
  .pytest_runtime/
  platform/.pytest_runtime/
  .mypy_cache/
  .ruff_cache/
  .coverage
  coverage.xml
  htmlcov/

  # Local application/runtime state and logs
  platform/runtime/
  runtime/
  *.log
  logs/

  # Secrets and local connection settings
  .env
  .env.*
  !.env.example
  *.pem
  *.key
  *.pfx
  *.p12

  # Local database files, backups and exports
  *.db
  *.sqlite
  *.sqlite3
  *.dump
  *.backup
  *.bak
  *.sql.gz
  *.tar.gz

  # CbCR filings and data extracts; retain deliberately curated mock data only
  *.xml
  *.XML
  *.csv
  *.tsv
  *.xlsx
  *.xls
  !mock_data/**/*.csv
  !mock_data/**/*.tsv
  !mock_data/**/*.xlsx
  !mock_data/**/*.xls

  # PostgreSQL client/session artefacts
  .pgpass
  pg_service.conf

  # Operating-system and editor artefacts
  .DS_Store
  Thumbs.db
  Desktop.ini
  .vscode/
  .idea/

  # Optional Node/Cloudflare build artefacts
  node_modules/
  dist/
  build/
  .wrangler/